# Copy to .env.supabase.local after provisioning the dedicated Futly project.
TURF_PERSISTENCE=supabase
TURF_SUPABASE_URL=https://PROJECT_REF.supabase.co
TURF_SUPABASE_PUBLISHABLE_KEY=PROJECT_PUBLISHABLE_KEY
# Generate a unique high-entropy base64url token; store only its SHA-256 hash in ledger_meta.
TURF_SUPABASE_SERVER_TOKEN=REPLACE_WITH_PRIVATE_SERVER_TOKEN
TURF_TIME_ZONE=Asia/Kolkata
PORT=5174
# Bootstrap is only needed for an empty ledger. Import existing staff first to preserve access.
# TURF_BOOTSTRAP_EMAIL=owner@example.com
# TURF_BOOTSTRAP_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
# TURF_BOOTSTRAP_NAME=Futly Owner
